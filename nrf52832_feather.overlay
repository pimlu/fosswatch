#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&spi1 {
        compatible = "nordic,nrf-spi";
        status = "okay";
        cs-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
        pinctrl-0 = <&spi1_default>;
        pinctrl-1 = <&spi1_sleep>;
        pinctrl-names = "default", "sleep";
        gendev: gendev@0 {
                compatible = "vnd,spi-device";
                reg = <0>;
                spi-max-frequency = <1000000>;
                label = "GenDev";
        };
};


&pinctrl {
    spi1_default: spi1_default {
        group1 {
            /* SPI1 active pins: SCK, MOSI, MISO */
            psels = <NRF_PSEL(SPIM_SCK, 0, 12)>, /* P0.12 */
                    <NRF_PSEL(SPIM_MOSI, 0, 13)>, /* P0.13 */
                    <NRF_PSEL(SPIM_MISO, 0, 14)>; /* P0.14 */
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            /* Sleep state: you can leave same pins or disable input buffer etc. */
            psels = <NRF_PSEL(SPIM_SCK, 0, 12)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 13)>,
                    <NRF_PSEL(SPIM_MISO, 0, 14)>;
            low-power-enable; /* example: put pins into low-power/input-disconnected */
        };
    };



    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>, /* P0.4 */
                    <NRF_PSEL(TWIM_SCL, 0, 5)>; /* P0.5 */
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };

    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 15)>, /* P0.15 */
                    <NRF_PSEL(UART_RX, 0, 16)>; /* P0.16 */
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 15)>,
                    <NRF_PSEL(UART_RX, 0, 16)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";

    pinctrl-0 = < &i2c0_default >;
    pinctrl-1 = < &i2c0_sleep >;
    pinctrl-names = "default", "sleep";


    mydevice: mydevice@10 {
        compatible = "vnd,i2c-device";
        reg = <0x10>;
        label = "MyDevice";
    };
};

&uart0 {
    compatible = "nordic,nrf-uarte";
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};